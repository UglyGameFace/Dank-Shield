# Dank Shield public production .env example
# Never commit real tokens, Supabase service-role keys, API secrets, or customer data.
# Public rule: Discord server IDs belong in Supabase guild_configs via /dank setup, not here.

DEPLOYMENT_ENV=production
DANK_DEPLOYMENT_MODE=production
DANK_PUBLIC_MODE=true
DANK_PRODUCTION_MODE=true
DANK_COMMAND_PROFILE=public

# Public safety: keep deployment-level Discord IDs disabled.
DANK_ALLOW_SERVER_ENV_IDS=false
DANK_SERVER_ENV_IDS_ENABLED=false
DANK_PUBLIC_CONFIG_ISOLATION=true

# Slash command behavior
DANK_SYNC_BETA_GUILD_COMMANDS=false
CLEAR_GLOBAL_COMMANDS_ON_BOOT=false
DANK_DANGEROUS_CLEAR_ALL_GLOBAL_COMMANDS_ON_BOOT=false
DANK_SKIP_UNCHANGED_GLOBAL_SYNC=true
DANK_FORCE_COMMAND_SYNC_ON_BOOT=false
DANK_COMMAND_SYNC_STATE_FILE=.dank_command_sync_state.json
DANK_GUILD_COMMAND_CLEANUP_IDS=

# Compact production logs
DANK_COMMAND_LOG_STYLE=compact
DANK_STARTUP_LOG_STYLE=compact

# Public scale/runtime controls
# Single-process AutoShardedBot is selected only when this is true.
# Canary on Discloud: DISCORD_SHARD_COUNT=2; REMOVE that override after
# confirming two healthy shards and use /gateway/bot auto-recommendation.
DISCORD_AUTO_SHARD=true
# DISCORD_SHARD_COUNT=2
DANK_EXPECTED_PUBLIC_GUILDS=100
# Caps for independent guild maintenance loops. Keep conservative for
# Discloud/Supabase; changing these does not create more Discord shards.
DANK_HEARTBEAT_GUILD_CONCURRENCY=8
DANK_METRICS_GUILD_CONCURRENCY=4
DANK_TICKET_SWEEP_GUILD_CONCURRENCY=3
DANK_SPAM_WARM_GUILD_CONCURRENCY=3
DANK_RUNTIME_JOBS_MAX_CONCURRENT=8
DANK_STARTUP_RECOVERY_MAX_CONCURRENT=1
# Keep all historical/startup repair traffic quiet while live Discord + site
# health establish themselves. Live event enforcement is not delayed.
DANK_STARTUP_RECOVERY_QUIET_SECONDS=120
# Discloud process-wide Discord REST headroom for startup/recovery work.
# Keep below the host's observed 300 requests / 30 seconds ceiling.
DANK_RECOVERY_DISCORD_REST_BUDGET_PER_30S=40
# Keep activity-history restart reconstruction outside the initial Discloud
# 30-second aggregate Discord REST window. Live activity listeners start immediately.
DANK_ACTIVITY_RECONCILE_START_DELAY_SECONDS=75
DANK_ACTIVITY_RECONCILE_TIMEOUT_SECONDS=180
DANK_STARTUP_CONFIG_BATCH_SIZE=200
DANK_STARTUP_TICKET_BACKFILL=false
DANK_STARTUP_TICKET_PANEL_REPAIR=false

# Per-guild config cache
DANK_GUILD_CONFIG_TABLE=guild_configs
DANK_GUILD_CONFIG_CACHE_TTL_SECONDS=60
# Protection Center read-only live-state load budget; applies generically to every guild.
DANK_PROTECTION_PANEL_LOAD_TIMEOUT_SECONDS=4

# Public legal/support URLs - fill before wider public rollout
PUBLIC_BOT_TERMS_URL=
PUBLIC_BOT_PRIVACY_URL=
PUBLIC_BOT_SUPPORT_URL=
PUBLIC_BOT_DATA_REQUEST_URL=

# Retention/community defaults
TICKET_TRANSCRIPT_RETENTION_DAYS=90
MODLOG_RETENTION_DAYS=180
METRICS_RETENTION_DAYS=180
COMMUNITY_AGE_GATE_REQUIRED=false
COMMUNITY_MINIMUM_AGE=18

# Dank Shield Live Captions (general server voice channels + Community Hub sessions)
# Keep disabled until a real Discord DAVE voice soak test passes on the deployed host.
# The legacy COMMUNITY name is retained for deployment compatibility.
DANK_COMMUNITY_LIVE_CAPTIONS_ENABLED=false

# Dank Shield Voice Safety #517: independent operator kill switch, OFF by default.
# Requires the above captions/DAVE validation gate to be enabled as well.
# Configure the selected VC, private staff alerts and public notice via
# /dank protection -> Voice Safety. Members separately opt in on the notice.
# Do not enable on Discloud until the real Discord voice soak passes.
DANK_VOICE_SAFETY_ENABLED=false
# Google unpaid API may use user content for product/model improvement.
# Only set both TRUE after legal/policy review, confirmation that GEMINI_API_KEY
# uses a billing-enabled paid API project with no-training terms, and verification
# that this monitored service is adult-only as required by Gemini API terms.
DANK_VOICE_SAFETY_GEMINI_PAID_CONFIRMED=false
DANK_VOICE_SAFETY_ADULT_ONLY_CONFIRMED=false
# Native Opus is bundled by requirements for deterministic PCM decoding.
# Optional operator override: absolute/full shared-library path accepted by discord.opus.load_opus().
DANK_OPUS_LIBRARY=
# Required only when Live Captions are enabled. Never commit a real key.
GEMINI_API_KEY=
# Gemini Live Transcribe keeps one streaming speech session per opted-in Discord speaker.
DANK_COMMUNITY_CAPTION_LIVE_MODEL=gemini-3.5-transcribe-live
# Empty language codes = auto-detect Gemini's full supported set (85+) and code-switching.
DANK_COMMUNITY_CAPTION_LANGUAGE_CODES=
DANK_COMMUNITY_CAPTION_TRANSCRIPTION_MODE=VERBATIM
# Optional comma-separated terms that are genuinely likely in your servers (game names, jargon, etc.).
# Keep this short/targeted; personal speaker language hints are configured in Discord, not here.
DANK_COMMUNITY_CAPTION_CUSTOM_VOCABULARY=
# English conversion is text-only and uses a separate lightweight model.
DANK_COMMUNITY_CAPTION_TRANSLATION_MODEL=gemini-3.1-flash-lite
# Process-wide cost/RAM/backpressure limits shared by general + Community Hub captions.
# Raise only after observing production load.
DANK_COMMUNITY_CAPTION_MAX_ACTIVE_GUILDS=4
DANK_COMMUNITY_CAPTION_MAX_SPEAKERS=8
DANK_COMMUNITY_CAPTION_MAX_CONCURRENT_TRANSCRIPTIONS=6


# Discord app secrets
DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=

# Supabase REST API - service role is required for the bot runtime.
# Database schema changes are deployed from committed supabase/migrations files;
# the bot runtime does not need or use a direct Postgres DSN for schema repair.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional shadow test: read-only REST calls from the EXISTING Discloud process
# to the pinned offline candidate. NEVER overwrite the active SUPABASE_* pair.
# Disabled by default. The secondary key stays private inside Discloud env.
DANK_CANDIDATE_REST_SHADOW_PROBE=false
DANK_CANDIDATE_SUPABASE_URL=
DANK_CANDIDATE_SUPABASE_SERVICE_ROLE_KEY=

# Verification website / internal bot API
VERIFY_SITE_URL=
BOT_ACTIONS_API_URL=http://127.0.0.1:8081
BOT_API_SHARED_SECRET=
BOT_API_BIND_HOST=127.0.0.1
BOT_API_PORT=8081
BOT_API_REQUIRE_AUTH=true
BOT_API_ALLOW_INSECURE=false
LEGACY_BOT_ACTIONS_API_ENABLED=false

# Torrent / Movie Night media playback
# Current production target: one 1.46 GiB Dank Shield Site process.
# Movie catalog / legal availability discovery.
# One bot-owner TMDB Read Access Token powers title/year/poster matching for every guild.
# It is metadata only; it never supplies a movie file. Watch availability is attributed
# to JustWatch via TMDB. Set the default ISO-3166-1 country used for that availability.
DANK_TMDB_READ_TOKEN=
DANK_TMDB_WATCH_REGION=US

# DANK_MEDIA_PUBLIC_BASE_URL must be the HTTPS Discloud Site URL for this app,
# for example https://stoneyverify.discloud.dev after the Site is live.
DANK_MEDIA_PUBLIC_BASE_URL=
DANK_MEDIA_SERVER_ENABLED=true
DANK_CINEMA_FEED_REFRESH_SECONDS=900
DANK_CINEMA_FEED_REFRESH_BATCH=24
DANK_MEDIA_BIND_HOST=0.0.0.0
DANK_MEDIA_PORT=8080
# Standalone Dank Cinema login uses the same Discord application as the bot.
# Client ID normally resolves from the running bot, so only override it if needed.
DANK_CINEMA_DISCORD_CLIENT_ID=
# Required for direct https://YOUR-SITE/cinema login.
# Also register https://YOUR-SITE/cinema/auth/callback in Discord Developer Portal > OAuth2.
DANK_CINEMA_DISCORD_CLIENT_SECRET=
# Optional explicit override. If set, it must exactly match the Discord Developer
# Portal OAuth2 Redirect entry, including scheme, host, and /cinema/auth/callback.
DANK_CINEMA_DISCORD_REDIRECT_URI=
# Use a dedicated random secret. Do not reuse BOT_API_SHARED_SECRET or DISCORD_TOKEN.
DANK_TORRENT_STREAM_SECRET=

# Dynamic Movie Night admission control.
# 1.46 GiB ~= 1495 MiB. The controller protects 350 MiB for the core bot and
# estimates 96 MiB of incremental RAM per new unique torrent.
DANK_PROCESS_MEMORY_LIMIT_MB=1495
DANK_MOVIE_NIGHT_MEMORY_RESERVE_MB=350
DANK_TORRENT_ESTIMATED_SESSION_MB=96
# Start conservatively at 2 unique torrents. Identical torrents are shared
# across rooms and do NOT consume another unique-session slot.
DANK_TORRENT_SOFT_SESSION_LIMIT=2
DANK_TORRENT_MAX_SESSIONS=4
DANK_TORRENT_MAX_UNIQUE_PER_GUILD=1
# Leave burst disabled until production telemetry proves the 3rd/4th unique
# session is safe on this host.
DANK_TORRENT_ALLOW_BURST=false

# Disk-backed media limits. These are not RAM buffers.
# 25 GiB max selected movie, 50 GiB max declared torrent, 64 GiB disk reserve.
DANK_TORRENT_MAX_METADATA_BYTES=4194304
DANK_TORRENT_MAX_FILE_BYTES=26843545600
DANK_TORRENT_MAX_TOTAL_BYTES=53687091200
DANK_TORRENT_DISK_RESERVE_BYTES=68719476736
# Diamond's 10 GB is shared across apps. Cinema independently caps
# its cache to 4 GiB (allowable range 512 MiB to 8 GiB). Host df is not
# the account quota. Large videos may be rejected by the cache budget.
DANK_TORRENT_CACHE_BUDGET_BYTES=4294967296
DANK_TORRENT_ORPHAN_GRACE_SECONDS=1800

# EXPERIMENTAL: pinned TorrServer rolling transport. OFF by default.
# Do NOT enable on Discloud before the real-engine integration, multi-guild
# stress tests, GPL review and private daemon deployment are accepted.
# The daemon MUST be restricted to 127.0.0.1, with UseDisk=false,
# RemoveCacheOnDrop=true, DisableUPNP=true, TorrentsSavePath EMPTY and
# CacheSize no larger than DANK_CINEMA_ROLLING_MEMORY_BUDGET_BYTES
# / (4 * DANK_TORRENT_MAX_SESSIONS). Its entire process RSS, not just
# CacheSize, must be counted against the Discloud RAM allocation.
# Prior tests disproved a reliable DISK-backed cache allocation ceiling.
# This setting is a reservation guard, not a hard RAM quota.
DANK_CINEMA_ROLLING_ENABLED=false
DANK_CINEMA_ROLLING_MEMORY_BUDGET_BYTES=134217728
# DANK_CINEMA_ROLLING_ENDPOINT=http://127.0.0.1:8090
# For 50+ GiB media the rolling mode also needs per-file and total caps
# set explicitly above the source metadata size. Never increase native
# disk-backed mode caps to accomplish this.

# Fallback read-ahead. The adaptive buffer stays between min/max below.
DANK_TORRENT_READAHEAD_BYTES=16777216
DANK_TORRENT_MIN_READAHEAD_BYTES=4194304
DANK_TORRENT_MAX_READAHEAD_BYTES=67108864
DANK_TORRENT_TARGET_BUFFER_SECONDS=30
DANK_TORRENT_MAX_BUFFER_SECONDS=75
DANK_TORRENT_MIN_ESTIMATED_PLAYBACK_BYTES_PER_SECOND=524288
DANK_TORRENT_BOOTSTRAP_BYTES=8388608
DANK_TORRENT_TAIL_PROBE_BYTES=4194304
DANK_TORRENT_BUFFER_WAIT_SECONDS=20
DANK_TORRENT_METADATA_WAIT_SECONDS=30
DANK_MOVIE_NIGHT_EMPTY_ROOM_TTL_SECONDS=1800
DANK_TORRENT_IDLE_TTL_SECONDS=1800

# Swarm/network tuning shared by all unique torrent sessions in this process.
# Provider/index seed counts are discovery hints; actual playback speed depends on
# live peers libtorrent reaches after the torrent starts.
DANK_TORRENT_CONNECTION_LIMIT=200
DANK_TORRENT_CONNECTION_SPEED=80
DANK_TORRENT_CONNECT_BOOST=80
DANK_TORRENT_PEER_CONNECT_TIMEOUT_SECONDS=8
DANK_TORRENT_DOWNLOAD_RATE_BYTES=67108864
DANK_TORRENT_UPLOAD_RATE_BYTES=524288
DANK_TORRENT_LISTEN_INTERFACES=0.0.0.0:6881,[::]:6881
DANK_TORRENT_TIME_CRITICAL_BASE_DEADLINE_MS=500
DANK_TORRENT_TIME_CRITICAL_STEP_MS=350

# Ticket defaults that are safe deployment-wide
TICKET_PREFIX=ticket
AUTO_DELETE_TICKET_SECONDS=0
TRANSCRIPT_PANEL_NAME=Support
SINGLE_PANEL_MODE=true
DANK_TICKET_CATEGORY_SOFT_LIMIT=49
DANK_TICKET_MAX_OVERFLOW_CATEGORIES=3
DANK_TICKET_OVERFLOW_AUTO_CREATE=true

# Verification timers
TOKEN_TTL_MINUTES=240
VC_REQUEST_TTL_MINUTES=240
VERIFY_KICK_HOURS=24
VC_REQUEST_COOLDOWN_SECONDS=60

# Moderation/raid/alt defaults
MOD_TIMEOUT_MINUTES=60
MOD_ACTION_AUDIT_LOOKBACK_SECONDS=20
RAID_WINDOW_SECONDS=60
RAID_JOIN_THRESHOLD=6
RAID_LOCK_MINUTES=15
RAID_MASS_ROLE_STRIP=true
ALT_NEW_ACCOUNT_DAYS=7
ALT_CLUSTER_WINDOW_MINUTES=30
ALT_CLUSTER_MIN_GROUP=3

# Optional role prompt / verification UI
ENABLE_OPTIONAL_ROLE_PROMPT=true
OPTIONAL_ROLE_AUTO_CLOSE_SECONDS=0
ALLOW_USER_VERIFYLINK=false
VERIFY_TOKEN_TABLE=verification_tokens
TOKEN_TABLE=verification_tokens

# Branding
BOT_DISPLAY_NAME=Dank Shield
VERIFY_UI_TITLE=Dank Shield Verification
DANK_SHIELD_TAGLINE_SHORT=Good vibes in. Bad actors out.
DANK_SHIELD_TAGLINE_LONG=Verification, tickets, and server protection without snuffing out the vibe.

# Intentionally omitted in public production:
# GUILD_ID, *_CHANNEL_ID, *_CATEGORY_ID, *_ROLE_ID, DANK_TICKET_OVERFLOW_CATEGORY_IDS
# Configure those per server with /dank setup so one server can never inherit another server's IDs.
DANK_DISABLE_RUNTIME_COMMAND_PRUNE=true
DANK_CLEAR_GLOBAL_COMMANDS_ON_BOOT=false
DANK_LOGIN_429_BACKOFF_SECONDS=1800
DANK_LOGIN_BACKOFF_STATE_FILE=.dank_login_backoff_until

# Discloud private PostgreSQL ONLY for unverified-member reminder delivery history.
# Copy the private PostgreSQL URL from Discloud DB dashboard into the bot's
# deployment environment. Never commit the actual URL or credentials.
# Dank Shield's existing Supabase guild configs and member role truth remain in Supabase.
DANK_VERIFY_REMINDER_DATABASE_URL=
# Future Dank Shield core Postgres port. Do NOT set until a tested repository
# layer/schema and data restore are ready; currently unused by bot startup.
# Private first-stage transfer only. Source ref = Supabase project's
# hostname prefix; expected DB is the name of the existing Discloud database.
# Neither variable activates PostgreSQL for the running bot.
DANK_MIGRATION_SOURCE_REF=
DANK_MIGRATION_EXPECTED_DB=
DANK_CORE_POSTGRES_DATABASE_URL=
# Measured Discloud PostgreSQL DISK allowance in MiB, NOT RAM (512 MB).
# Leave blank until confirmed. Read-only inspector uses 70%/85% alerts.
DANK_PG_STORAGE_BUDGET_MB=

# Optional private VLAN diagnostic connection to Watch Yo Mouf.
# Only port 8097 on the Discloud VLAN; no public website route and no voice rights.
# Do not reuse BOT_API_SHARED_SECRET or a bot/Gemini token.
DANK_VOICE_BRIDGE_ENABLED=false
DANK_VOICE_BRIDGE_SECRET=


# Member-activity write batching (scales the per-event ledger RPC).
# Events are deduplicated in memory and flushed in bounded idempotent chunks.
# REQUIRED before deployment: apply 20261013120000_member_activity_batch_rpc.sql.
# No lossy per-event fallback: failed chunks retain their IDs and retry only
# after the DB breaker allows them. Receipts are acknowledged and pruned.
DANK_ACTIVITY_FLUSH_SECONDS=15
DANK_ACTIVITY_BUFFER_MAX_ENTRIES=50000
DANK_ACTIVITY_BREAKER_THRESHOLD=3
DANK_ACTIVITY_BREAKER_COOLDOWN_SECONDS=120

# Ticket-channel identity cache: how long a "not a ticket channel" verdict is
# trusted before re-checking the DB (seconds). Positive hits never expire;
# ticket open/reopen/delete lifecycle hooks keep the set exact.
DANK_TICKET_CHANNEL_NEGATIVE_TTL_SECONDS=300